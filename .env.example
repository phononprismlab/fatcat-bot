# ===== 肥肥风筝猫 配置示例 =====
# 复制为 .env 后按需修改

# OneBot 11 连接地址（反向 WS：本程序主动连 NapCat 的 WS 服务）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# NapCat 里设置的 access token（没有就留空）
ONEBOT_ACCESS_TOKEN=
# 动作超时（毫秒）
ONEBOT_ECHO_TIMEOUT_MS=15000

# 指令前缀
COMMAND_PREFIX=/

# 记录口令
START_PHRASE=我要口嗨了
END_PHRASE=我口嗨完了

# 大模型总结（三项任一为空则关闭总结，不消耗 token）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 回旋镖默认间隔（天）
BOOMERANG_DEFAULT_DAYS=3

# 数据目录（数据库、导出、上传文件都在这里）
DATA_DIR=./data
