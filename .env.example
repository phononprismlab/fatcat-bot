# ===== 肥肥风筝猫 配置示例 =====
# 复制为 .env 后按需修改

# OneBot 11 连接地址（反向 WS：本程序主动连 NapCat 的 WS 服务）
ONEBOT_WS_URL=ws://127.0.0.1:3001
# NapCat 里设置的 access token（没有就留空）
ONEBOT_ACCESS_TOKEN=
# 动作超时（毫秒）
ONEBOT_ECHO_TIMEOUT_MS=15000

# 指令前缀
COMMAND_PREFIX=/

# 记录口令
START_PHRASE=我要口嗨了
END_PHRASE=我口嗨完了

# 大模型总结（三项任一为空则关闭总结，不消耗 token）
# 接口走 OpenAI 兼容格式（POST {BASE_URL}/chat/completions，Bearer 鉴权），
# 所以任何 OpenAI 兼容服务都能接，包括智谱 GLM-4 免费版：
#   1. 去 https://open.bigmodel.cn/ 注册，在「用户中心 → API Keys」新建一个 key
#   2. 把 key 填到 LLM_API_KEY，下面两项照抄即可（免费模型 glm-4-flash）
LLM_BASE_URL=https://open.bigmodel.cn/api/pi/openai/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash

# 回旋镖默认间隔（天）
BOOMERANG_DEFAULT_DAYS=3

# 单用户资料库字符总量上限（0 = 不限制）。托管档用来防单人塞满磁盘。
USER_QUOTA_CHARS=2000000

# PDF 导出用的中文字体（.ttf / .ttc）。留空则自动探测系统字体；
# 探测失败时 PDF 导出会自动回退成 txt。
FONT_PATH=

# ===== Web 管理台 =====
# 监听地址。默认只绑本机；改成 0.0.0.0 会让外网能访问，务必配合强口令。
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
# 登录口令。不设置则每次启动随机生成并打印在日志里（重启就变）。
ADMIN_TOKEN=
# 登录有效期（小时）
ADMIN_SESSION_TTL_HOURS=12
# ADMIN_ONLY=1：只启动管理台，不连 OneBot（NapCat 挂了也能进去看数据）
ADMIN_ONLY=

# 数据目录（数据库、导出、上传文件都在这里）
DATA_DIR=./data

# ===== 掉线监控与告警 =====
# 账号被风控 / 挤下线时，WS 可能还连着但收不到任何消息；此时 bot 自己没法用 QQ 通知你，
# 所以告警走带外 webhook。支持：企业微信 / 钉钉 / 飞书 群机器人、Server 酱、任意 JSON 接口。
# 留空 = 只写日志，不对外告警。
ALERT_WEBHOOK_URL=
# 探活间隔（分钟，最小 30 秒）
MONITOR_INTERVAL_MIN=2
# 持续故障时的告警冷却（分钟），避免刷屏
ALERT_COOLDOWN_MIN=30
# MONITOR=0 完全关闭掉线监控
MONITOR=

# ===== 备份（deploy/backup.sh / fatcat-backup.timer 用）=====
# 备份目录，留空 = <项目目录>/backups
BACKUP_DIR=
# 保留份数，超出后自动删最旧的
BACKUP_KEEP=14
# 备份成功后的异地同步命令（强烈建议配，本地备份挡不住整机故障），例如：
#   BACKUP_OFFSITE_CMD=rclone sync "$BACKUP_DIR/latest" oss:fatcat-backup
#   BACKUP_OFFSITE_CMD=rsync -az --delete "$BACKUP_DIR/latest" backup@10.0.0.9:/srv/fatcat/
BACKUP_OFFSITE_CMD=

# ===== Docker 部署专用（deploy/docker-compose.yml）=====
# 不用 Docker 的话这几项可以不管。
# NapCat 容器以哪个 uid/gid 落盘；直接填当前用户即可：id -u / id -g
NAPCAT_UID=1000
NAPCAT_GID=1000
# NapCat WebUI 登录口令。**必填**，compose 没读到会直接报错，
# 就是为了避免出现默认弱口令。公网环境请务必设强口令。
NAPCAT_WEBUI_TOKEN=
# 构建镜像时容器内 apt 用的源。**国内服务器必填**，否则构建会卡在 deb.debian.org 上超时。
#   腾讯云内网：mirrors.tencentyun.com
#   公网可用：  mirrors.aliyun.com / mirrors.ustc.edu.cn / mirrors.cloud.tencent.com
# 海外环境留空，用 Debian 官方源。
APT_MIRROR=
